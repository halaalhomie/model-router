GEMINI_API_KEY=replace_with_your_api_key

# The classifier runs on every request, so it uses the cheapest model we trust.
# flash-lite also does no "thinking", which keeps classification fast.
GEMINI_ANALYZER_MODEL=gemini-3.5-flash-lite

# The routed models. Versions are pinned rather than using the "-latest"
# aliases: a floating alias would silently change the model underneath our
# evaluation metrics, making historical comparisons meaningless.
#
# Measured on a free-tier key (see README "Model availability"):
#   gemini-3.5-flash-lite   ~2s    no thinking tokens
#   gemini-3.5-flash        ~6-14s ~600-1200 thinking tokens
#   gemini-3.6-flash        ~19s   ~900 thinking tokens
#   gemini-3.7-flash        504 DEADLINE_EXCEEDED - unusable
#   any *-pro model         429 RESOURCE_EXHAUSTED - needs billing enabled
GEMINI_FAST_MODEL=gemini-3.5-flash-lite
# Was gemini-3.5-flash until the evaluation harness measured it. At
# $1.50/$9.00 per 1M it is the dearest model in the catalog -- twice the
# input rate and 2.4x the output rate of gemini-3.6-flash -- so routing a
# coding request "up" to it cost more than never routing at all. On the
# first four dataset cases that single choice made routing 71.9% more
# expensive than the baseline; switching it made routing 32.1% cheaper.
# See README, "What the harness found".
GEMINI_CODE_MODEL=gemini-3.6-flash
GEMINI_REASONING_MODEL=gemini-3.6-flash
GEMINI_LONG_CONTEXT_MODEL=gemini-3.6-flash

# Optional. Per-request timeout, in seconds. code_model/reasoning_model run
# up to ~19s normally (see the measurements above), so 30s gives headroom
# without leaving a genuinely stuck request hanging for the SDK's 10-minute
# default. If a request still fails after retries, it falls back once to
# GEMINI_FAST_MODEL rather than failing outright.
# Gemini itself rejects anything under 10s with a 400 -- config.py enforces
# that floor at startup rather than letting it surface as a request-time error.
# REQUEST_TIMEOUT_SECONDS=30

# Read by docker-compose.yml to create the Postgres container, and by
# app/config.py to build the connection URL from those same values --
# one source of truth rather than a second copy of the password. Any
# values work; this is a local container nothing external connects to.
POSTGRES_USER=router
POSTGRES_PASSWORD=replace_with_a_local_dev_password
POSTGRES_DB=model_router

# Optional. Where the app looks for that database. Defaults suit the
# container above; override when Postgres runs elsewhere.
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# Optional. Overrides everything above -- what a deployment pointing at a
# managed database would set instead of the discrete variables.
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Optional. Where to publish request events. Defaults to localhost:9092,
# matching docker-compose.yml's PLAINTEXT_HOST listener (what Kafka is
# reachable at from the host). If Kafka is down, requests still succeed --
# publishing is deliberately best-effort, never on the critical path.
# KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Optional. The consumer group app/consumer.py joins. Kafka tracks
# committed offsets per group, so changing this name gives you a fresh
# reader that replays the topic from the beginning, independently of the
# old one -- handy for experimenting without disturbing existing progress.
# KAFKA_CONSUMER_GROUP=model-router.analytics
