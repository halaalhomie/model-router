GEMINI_API_KEY=replace_with_your_api_key

# The classifier runs on every request, so it uses the cheapest model we trust.
# flash-lite also does no "thinking", which keeps classification fast.
GEMINI_ANALYZER_MODEL=gemini-3.5-flash-lite

# The routed models. Versions are pinned rather than using the "-latest"
# aliases: a floating alias would silently change the model underneath our
# evaluation metrics, making historical comparisons meaningless.
#
# Measured on a free-tier key (see README "Model availability"):
#   gemini-3.5-flash-lite   ~2s    no thinking tokens
#   gemini-3.5-flash        ~6-14s ~600-1200 thinking tokens
#   gemini-3.6-flash        ~19s   ~900 thinking tokens
#   gemini-3.7-flash        504 DEADLINE_EXCEEDED - unusable
#   any *-pro model         429 RESOURCE_EXHAUSTED - needs billing enabled
GEMINI_FAST_MODEL=gemini-3.5-flash-lite
GEMINI_CODE_MODEL=gemini-3.5-flash
GEMINI_REASONING_MODEL=gemini-3.6-flash
GEMINI_LONG_CONTEXT_MODEL=gemini-3.6-flash

# Optional. Per-request timeout, in seconds. code_model/reasoning_model run
# up to ~19s normally (see the measurements above), so 30s gives headroom
# without leaving a genuinely stuck request hanging for the SDK's 10-minute
# default. If a request still fails after retries, it falls back once to
# GEMINI_FAST_MODEL rather than failing outright.
# Gemini itself rejects anything under 10s with a 400 -- config.py enforces
# that floor at startup rather than letting it surface as a request-time error.
# REQUEST_TIMEOUT_SECONDS=30

# Read by docker-compose.yml to set up the local Postgres container (not
# used by app code until Phase 6). Any values work -- this is a local dev
# container nothing external ever connects to.
POSTGRES_USER=router
POSTGRES_PASSWORD=replace_with_a_local_dev_password
POSTGRES_DB=model_router
